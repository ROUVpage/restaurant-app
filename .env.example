# Reservation notification webhook for Make/Zapier/Power Automate
RESERVATION_WEBHOOK_URL=https://hook.example.com/your-webhook-url

# Optional SMTP fallback if you want direct email sending instead of a webhook
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_password_or_app_password
MAIL_FROM="Bar Reservas <your_email@example.com>"

# Optional Google Calendar integration
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# PayPal Checkout (required for real secure payments)
# PAYPAL_ENV can be: sandbox or live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
# Required to encrypt merchant OAuth tokens at rest (set a long random secret)
PAYPAL_TOKEN_ENCRYPTION_KEY=
# Optional override for OAuth scopes requested during Connect with PayPal
PAYPAL_CONNECT_SCOPE=openid profile email https://uri.paypal.com/services/payments/payment/authcapture
